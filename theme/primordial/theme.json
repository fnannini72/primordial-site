{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "base", "name": "Mist", "color": "#F5F2F7" },
				{ "slug": "surface", "name": "Lilac paper", "color": "#ECE6F0" },
				{ "slug": "ink", "name": "Ink", "color": "#22092F" },
				{ "slug": "muted", "name": "Dusk", "color": "#5E4E68" },
				{ "slug": "line", "name": "Line", "color": "#D9CFE0" },
				{ "slug": "night", "name": "Night", "color": "#390C51" },
				{ "slug": "night-deep", "name": "Deep night", "color": "#250735" },
				{ "slug": "amber", "name": "Amber", "color": "#F89828" },
				{ "slug": "ember", "name": "Ember", "color": "#F2541B" },
				{ "slug": "violet", "name": "Violet", "color": "#8B29DE" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "fire", "name": "Fire", "gradient": "linear-gradient(160deg, #F89828 0%, #F2541B 100%)" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1160px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.5rem, 3vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 6rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 11vw, 9rem)" }
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Montserrat",
					"fontFamily": "Montserrat, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/montserrat.woff2"] }
					]
				},
				{
					"slug": "text",
					"name": "Literata",
					"fontFamily": "Literata, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "200 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/literata.woff2"] },
						{ "fontFamily": "Literata", "fontStyle": "italic", "fontWeight": "200 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/literata-italic.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "large", "name": "Lead", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Heading", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.6rem", "max": "5rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|ink" },
		"typography": {
			"fontFamily": "var:preset|font-family|text",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(1rem, 4vw, 2.5rem)", "right": "clamp(1rem, 4vw, 2.5rem)", "top": "0", "bottom": "0" }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "800", "lineHeight": "1.1", "letterSpacing": "-0.015em" },
				"color": { "text": "inherit" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "1.375rem", "fontWeight": "700" } },
			"h4": { "typography": { "fontSize": "1.125rem", "fontWeight": "700" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|ember" } },
				":focus": { "color": { "text": "var:preset|color|ember" } }
			},
			"button": {
				"color": { "background": "var:preset|color|amber", "text": "var:preset|color|night-deep" },
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "700", "fontSize": "1rem", "letterSpacing": "0.01em" },
				"border": { "radius": "999px", "width": "0", "style": "none" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var:preset|color|ember", "text": "var:preset|color|white" } },
				":focus": { "color": { "background": "var:preset|color|ember", "text": "var:preset|color|white" } }
			},
			"caption": { "typography": { "fontSize": "var:preset|font-size|small" }, "color": { "text": "var:preset|color|muted" } }
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "fontSize": "0.9375rem" }
			},
			"core/separator": {
				"color": { "background": "var:preset|color|line", "text": "var:preset|color|line" }
			},
			"core/quote": {
				"typography": { "fontStyle": "italic", "fontSize": "var:preset|font-size|large" },
				"border": { "left": { "color": "var:preset|color|amber", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing (no title)", "postTypes": ["page"] }
	]
}
